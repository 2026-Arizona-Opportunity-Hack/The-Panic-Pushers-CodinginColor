# Copy to .env and fill in real values. .env is gitignored; this file documents
# what the app needs. Never put real keys or passwords in this file.

# Neon OWNER connection string. Used only by `npm run db:setup` (creates tables).
DATABASE_URL=postgres://OWNER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Restricted app role, written to .env by `npm run db:setup` (row-level security applies to it).
# This is the one Vercel uses at runtime.
APP_DATABASE_URL=postgres://cic_app:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Not used yet: reserved for AI hints through the OHack AI gateway (see README,
# Known gaps). Hints today come from the author's hints and built-in nudges.
# OPENAI_BASE_URL=https://ai.ohack.dev/v1
# OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini

# Optional, for `npm run db:setup` only
# ADMIN_EMAIL=          # first admin account (default admin@codingincolor.net)
# ADMIN_NAME=           # display name for that admin
# SEED_PASSWORD=        # admin password (random and printed once if empty)
# APP_DB_PASSWORD=      # fixed password for the cic_app role (random if empty)

# Demo data for `npm run db:seed`
# DEMO_STAFF_PASSWORD=  # password for the demo instructor that npm run db:seed creates (skipped if empty)
# DEMO_PIN=1234         # PIN for every demo student
